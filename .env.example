APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app
APP_ENCRYPTION_SECRET_KEY=replace-with-a-32-byte-secret

SPRING_DATASOURCE_URL=jdbc:postgresql://db.your-project.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace-with-your-supabase-db-password

SPRING_DATA_REDIS_HOST=your-database.upstash.io
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_USERNAME=default
SPRING_DATA_REDIS_PASSWORD=replace-with-your-upstash-password
SPRING_DATA_REDIS_SSL_ENABLED=true
