# Leave empty in local development to use Vite's /api proxy.
VITE_API_BASE_URL=

# Local backend URL used by the Vite dev proxy.
# If you run the backend with `./gradlew bootRun`, keep 8080.
# If you run the backend with Docker Compose, change this to http://localhost:8081.
VITE_API_PROXY_TARGET=http://localhost:8080
